# Custom Apache Airflow image equipped with ML core dependencies
FROM apache/airflow:2.9.3-python3.11

USER airflow

# Install ML, MLOps, and pipeline dependencies for automated retraining in Phase 7
RUN pip install --no-cache-dir \
    "scikit-learn>=1.3.0,<1.5.0" \
    "xgboost>=2.0.0,<2.2.0" \
    "pandas>=2.1.0,<2.3.0" \
    "numpy>=1.24.0,<2.0.0" \
    "scipy>=1.11.0,<1.14.0" \
    "joblib>=1.3.0" \
    "mlflow>=2.10.0,<3.0.0" \
    "redis>=5.0.0" \
    "requests>=2.31.0" \
    "pyyaml>=6.0.1"
