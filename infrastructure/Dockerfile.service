# Dockerfile for FastAPI Real-Time Inference Service & Background Stream Consumer
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source code, frontend, and configuration
COPY config/ /app/config/
COPY ml_core/ /app/ml_core/
COPY services/ /app/services/
COPY frontend/ /app/frontend/

EXPOSE 8000

HEALTHCHECK --interval=5s --timeout=5s --retries=6 --start-period=5s \
    CMD curl --fail http://localhost:8000/health || exit 1

CMD ["uvicorn", "services.inference.app:app", "--host", "0.0.0.0", "--port", "8000"]
